<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.soulknight.ui.GameOverScreen"
           stylesheets="@../CSS/GameOverScreen.css"
           styleClass="gameover-root"
           fx:id="rootPane">

    <VBox styleClass="gameover-box"
          alignment="CENTER"
          spacing="22"
          maxWidth="580"
          maxHeight="280">

        <Label text="[ SYSTEM TERMINATED ]" styleClass="gameover-subtitle"/>

        <Label text="GAME OVER" styleClass="gameover-title"/>

        <Label fx:id="promptLabel"
               text="&gt; PRESS ENTER OR CLICK TO RESTART &lt;"
               styleClass="gameover-prompt"
               onMouseClicked="#handleRestart"/>

    </VBox>

</StackPane>