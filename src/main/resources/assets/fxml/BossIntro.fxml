<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.soulknight.ui.BossIntroController"
           prefWidth="1024" prefHeight="768"
           styleClass="boss-intro-overlay"
           stylesheets="@../CSS/BossIntro.css">
    <StackPane alignment="CENTER" maxHeight="260" prefHeight="260" mouseTransparent="true">
        <Region fx:id="bannerBackground" styleClass="boss-banner-strip" />
        <HBox alignment="CENTER" spacing="30" maxWidth="960">
            <padding>
                <Insets left="40" right="40" />
            </padding>
            <VBox fx:id="textContent" alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                <Label text="VOID" styleClass="boss-title-main" />
                <Label text="LORD" styleClass="boss-title-main" />
                <Label text="— GENERAL OF DARKNESS —" styleClass="boss-subtitle" />
            </VBox>
            <StackPane alignment="CENTER">
                <ImageView fx:id="bossImageView" fitWidth="300" fitHeight="300" preserveRatio="true">
                    <image>
                        <Image url="@../boss/boss.png" />
                    </image>
                </ImageView>
            </StackPane>

        </HBox>
    </StackPane>

</StackPane>