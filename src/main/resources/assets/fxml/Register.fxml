<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="registerRoot"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.soulknight.ui.RegisterController"
           stylesheets="@../CSS/login.css"
           prefWidth="1000"
           prefHeight="600"
           styleClass="register-root">

    <Canvas fx:id="backgroundCanvas"
            width="1000"
            height="600"
            mouseTransparent="true"/>

    <VBox fx:id="registerBox"
          alignment="CENTER"
          spacing="16"
          maxWidth="400"
          styleClass="register-box">

        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <Label text="REGISTER"
               styleClass="register-title"/>

        <Label text="CREATE LOCAL PROFILE"
               styleClass="session-label"/>

        <TextField fx:id="usernameField"
                   promptText="USERNAME"
                   styleClass="pixel-field"/>

        <PasswordField fx:id="passwordField"
                       promptText="PASSWORD"
                       styleClass="pixel-field"/>

        <PasswordField fx:id="confirmPasswordField"
                       promptText="CONFIRM PASSWORD"
                       onAction="#handleRegister"
                       styleClass="pixel-field"/>

        <Label fx:id="messageLabel"
               wrapText="true"
               styleClass="message-label"/>

        <Button fx:id="registerButton"
                text="CREATE ACCOUNT"
                maxWidth="Infinity"
                onAction="#handleRegister"
                styleClass="button-primary"/>

        <Button text="BACK TO LOGIN"
                maxWidth="Infinity"
                onAction="#openLogin"
                styleClass="button-secondary"/>

    </VBox>
</StackPane>
