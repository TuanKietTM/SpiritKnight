<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.soulknight.ui.AccountController"
           stylesheets="@../CSS/Account.css"
           styleClass="account-root">

    <VBox maxWidth="460"
          spacing="14"
          alignment="CENTER"
          styleClass="account-window">

        <padding>
            <Insets top="24" right="30" bottom="24" left="30"/>
        </padding>

        <Label text="PLAYER ACCOUNT" styleClass="account-title"/>

        <VBox spacing="4" styleClass="account-info-box">
            <Label text="PLAYER NAME" styleClass="field-caption"/>
            <Label fx:id="usernameLabel" text="PLAYER" styleClass="username-label"/>
        </VBox>

        <Label text="CURRENT PASSWORD" styleClass="field-caption"/>
        <PasswordField fx:id="currentPasswordField"
                       promptText="Current password"
                       styleClass="account-field"/>

        <Label text="NEW PASSWORD" styleClass="field-caption"/>
        <PasswordField fx:id="newPasswordField"
                       promptText="At least 8 characters"
                       styleClass="account-field"/>

        <Label text="CONFIRM NEW PASSWORD" styleClass="field-caption"/>
        <PasswordField fx:id="confirmPasswordField"
                       promptText="Confirm new password"
                       styleClass="account-field"/>

        <Label fx:id="messageLabel"
               wrapText="true"
               styleClass="message-label"/>

        <Button fx:id="changePasswordButton"
                text="CHANGE PASSWORD"
                onAction="#handleChangePassword"
                maxWidth="Infinity"
                styleClass="account-action-button"/>

        <Button text="LOG OUT"
                onAction="#handleLogout"
                maxWidth="Infinity"
                styleClass="account-logout-button"/>

        <Button text="BACK"
                onAction="#handleBack"
                maxWidth="Infinity"
                styleClass="account-back-button"/>
    </VBox>
</StackPane>