<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.soulknight.ui.AccountController"
           stylesheets="@../CSS/Account.css"
           styleClass="account-root">

    <VBox maxWidth="560.0"
          prefWidth="560.0"
          spacing="18.0"
          styleClass="account-window">

        <padding>
            <Insets top="26.0" right="30.0" bottom="26.0" left="30.0"/>
        </padding>

        <!-- Title Header -->
        <VBox spacing="6.0">
            <Label text="PLAYER ACCOUNT" styleClass="account-title"/>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Region prefWidth="38.0" prefHeight="2.0" styleClass="account-title-line"/>
                <Label text="SOUL NEXUS IDENTITY ARCHIVE" styleClass="account-subtitle"/>
            </HBox>
        </VBox>

        <!-- Active Profile -->
        <VBox spacing="5.0" styleClass="account-info-box">
            <Label text="ACTIVE PROFILE" styleClass="field-caption"/>
            <Label fx:id="usernameLabel" text="PLAYER" styleClass="username-label"/>
        </VBox>

        <!-- Form Password Inputs -->
        <VBox spacing="8.0" styleClass="account-form">
            <Label text="CURRENT PASSWORD" styleClass="field-caption"/>
            <PasswordField fx:id="currentPasswordField"
                           promptText="Enter current password"
                           styleClass="account-field"/>

            <Label text="NEW PASSWORD" styleClass="field-caption"/>
            <PasswordField fx:id="newPasswordField"
                           promptText="At least 8 characters"
                           styleClass="account-field"/>

            <Label text="CONFIRM NEW PASSWORD" styleClass="field-caption"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm new password"
                           styleClass="account-field"/>
        </VBox>

        <!-- Notification Message -->
        <Label fx:id="messageLabel"
               wrapText="true"
               styleClass="message-label"/>

        <!-- Change Password Button -->
        <Button fx:id="changePasswordButton"
                text="CHANGE PASSWORD"
                onAction="#handleChangePassword"
                maxWidth="Infinity"
                focusTraversable="false"
                styleClass="account-action-button"/>

        <!-- Bottom Action Buttons -->
        <HBox spacing="12.0">
            <Button text="LOG OUT"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"
                    focusTraversable="false"
                    styleClass="account-logout-button"/>

            <Button text="BACK"
                    onAction="#handleBack"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"
                    focusTraversable="false"
                    styleClass="account-back-button"/>
        </HBox>
    </VBox>
</StackPane>