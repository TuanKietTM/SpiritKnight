<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.soulknight.ui.LeaderboardController"
           stylesheets="@../CSS/login.css"
           styleClass="leaderboard-overlay">

    <VBox alignment="CENTER"
          spacing="16"
          maxWidth="680"
          maxHeight="520"
          styleClass="leaderboard-window">

        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>

        <!-- TITLE -->
        <Label text="KNIGHT LEADERBOARD"
               styleClass="leaderboard-title"/>

        <!-- TABLEVIEW -->
        <TableView fx:id="leaderboardTable"
                   prefHeight="380">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="rankColumn"
                             text="#"
                             prefWidth="60"
                             resizable="false"/>

                <TableColumn fx:id="nameColumn"
                             text="KNIGHT"
                             prefWidth="240"/>

                <TableColumn fx:id="scoreColumn"
                             text="SCORE"
                             prefWidth="140"/>

                <TableColumn fx:id="goldColumn"
                             text="GOLD"
                             prefWidth="140"/>
            </columns>
        </TableView>

        <!-- CLOSE BUTTON -->
        <Button text="CLOSE"
                onAction="#handleClose"
                maxWidth="200"
                styleClass="button-secondary"/>
    </VBox>
</StackPane>