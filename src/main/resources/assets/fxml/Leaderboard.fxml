<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.soulknight.ui.LeaderboardController"
           stylesheets="@../CSS/leaderboard.css"
           styleClass="leaderboard-overlay">

    <VBox alignment="CENTER"
          spacing="16.0"
          maxWidth="760.0"
          maxHeight="560.0"
          prefWidth="760.0"
          prefHeight="560.0"
          styleClass="leaderboard-window">

        <padding>
            <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
        </padding>

        <VBox spacing="6.0" alignment="CENTER_LEFT">
            <Label text="HALL OF HEROES" styleClass="leaderboard-title"/>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Region prefWidth="38.0" prefHeight="2.0" styleClass="leaderboard-title-line"/>
                <Label text="SOUL NEXUS RECORD ARCHIVE" styleClass="leaderboard-subtitle"/>
            </HBox>
        </VBox>

        <TableView fx:id="leaderboardTable"
                   prefHeight="410.0"
                   VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="rankColumn"
                             text="#"
                             prefWidth="65.0"
                             resizable="false"/>
                <TableColumn fx:id="nameColumn"
                             text="PLAYER"
                             prefWidth="285.0"/>
                <TableColumn fx:id="scoreColumn"
                             text="SCORE"
                             prefWidth="165.0"/>
                <TableColumn fx:id="goldColumn"
                             text="GOLD"
                             prefWidth="165.0"/>
            </columns>
        </TableView>

        <Button text="BACK TO NEXUS"
                onAction="#handleClose"
                maxWidth="240.0"
                focusTraversable="false"
                styleClass="leaderboard-close-button"/>
    </VBox>
</StackPane>
