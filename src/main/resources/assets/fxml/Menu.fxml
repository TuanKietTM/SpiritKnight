<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.soulknight.ui.Menu"
            stylesheets="@../CSS/Menu.css"
            styleClass="menu-container">

    <!-- Lop phu lam toi background -->
    <AnchorPane styleClass="menu-background-overlay"
                mouseTransparent="true"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"/>

    <!-- Tieu de -->
    <VBox alignment="CENTER"
          spacing="6"
          mouseTransparent="true"
          AnchorPane.topAnchor="38.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">

        <Label text="SOUL KNIGHT"
               styleClass="menu-title"/>

        <Label text="THE KCD VERSION"
               styleClass="menu-subtitle"/>
    </VBox>

    <!-- Noi dung chinh -->
    <HBox alignment="CENTER"
          spacing="150"
          AnchorPane.topAnchor="130.0"
          AnchorPane.bottomAnchor="45.0"
          AnchorPane.leftAnchor="70.0"
          AnchorPane.rightAnchor="70.0">

        <!-- Khu vuc nhan vat -->
        <StackPane prefWidth="430"
                   prefHeight="430"
                   alignment="CENTER"
                   styleClass="character-area">

            <VBox styleClass="mystic-aura-circle"
                  mouseTransparent="true"/>

            <VBox alignment="BOTTOM_CENTER"
                  spacing="5"
                  mouseTransparent="true">

                <ImageView fx:id="imgCharacter"
                           fitWidth="260"
                           fitHeight="310"
                           preserveRatio="true"
                           smooth="false"
                           styleClass="menu-sprite"/>

                <VBox prefWidth="190"
                      prefHeight="25"
                      styleClass="shadow-ellipse"/>
            </VBox>
        </StackPane>

        <!-- Khu vuc nut menu -->
        <VBox alignment="CENTER"
              spacing="11"
              prefWidth="310"
              styleClass="button-container">

            <Button fx:id="btnNewGame"
                    text="NEW GAME"
                    onAction="#onNewGameClicked"
                    prefWidth="290"
                    focusTraversable="false"
                    styleClass="menu-button, menu-button-primary">

                <graphic>
                    <ImageView fx:id="newGameIcon"
                               fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnContinue"
                    text="CONTINUE"
                    onAction="#onContinueClicked"
                    prefWidth="290"
                    focusTraversable="false"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="continueIcon"
                               fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnLeaderboard"
                    text="LEADERBOARD"
                    onAction="#onLeaderboardClicked"
                    prefWidth="290"
                    focusTraversable="false"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="leaderboardIcon"
                               fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnShop"
                    text="SHOP"
                    onAction="#onShopClicked"
                    prefWidth="290"
                    focusTraversable="false"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="shopIcon"
                               fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="accountButton"
                    text="PLAYER ACCOUNT"
                    onAction="#openAccount"
                    prefWidth="290"
                    focusTraversable="false"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="accountIcon"
                               fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnSettings"
                    text="SETTINGS"
                    onAction="#onSettingsClicked"
                    prefWidth="290"
                    focusTraversable="false"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="settingsIcon"
                               fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnExit"
                    text="EXIT GAME"
                    onAction="#onExitClicked"
                    prefWidth="290"
                    focusTraversable="false"
                    styleClass="menu-button-exit">

                <graphic>
                    <ImageView fx:id="exitIcon"
                               fitWidth="22"
                               fitHeight="22"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>
        </VBox>
    </HBox>
</AnchorPane>