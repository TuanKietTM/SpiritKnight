<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.soulknight.ui.Menu"
           stylesheets="@../CSS/Menu.css"
           styleClass="menu-container">

    <!-- Renderer ve khong gian trung gian tai layer duoi cung -->
    <Canvas fx:id="nexusCanvas"
            width="1024.0"
            height="576.0"
            mouseTransparent="true"/>

    <!-- Lop toi mep man hinh -->
    <AnchorPane mouseTransparent="true"
                styleClass="menu-vignette"/>

    <AnchorPane pickOnBounds="false">

        <!-- Tieu de -->
        <VBox alignment="TOP_LEFT"
              spacing="8.0"
              AnchorPane.topAnchor="38.0"
              AnchorPane.leftAnchor="56.0">

            <Label text="SOUL KNIGHT"
                   styleClass="menu-title"/>

            <HBox alignment="CENTER_LEFT"
                  spacing="10.0">

                <Region prefWidth="44.0"
                        prefHeight="2.0"
                        styleClass="title-line"/>

                <Label text="THE CROSSROADS"
                       styleClass="menu-subtitle"/>
            </HBox>
        </VBox>

        <!-- Bang menu ben trai -->
        <VBox alignment="CENTER_LEFT"
              spacing="10.0"
              prefWidth="326.0"
              styleClass="menu-panel"
              AnchorPane.leftAnchor="54.0"
              AnchorPane.topAnchor="148.0"
              AnchorPane.bottomAnchor="50.0">

            <Label text="CHOOSE YOUR PATH"
                   styleClass="menu-section-title"/>

            <Region prefHeight="1.0"
                    maxWidth="292.0"
                    styleClass="menu-divider"/>

            <Button fx:id="btnContinue"
                    text="CONTINUE MISSION"
                    onAction="#onContinueClicked"
                    focusTraversable="false"
                    contentDisplay="LEFT"
                    graphicTextGap="14.0"
                    styleClass="menu-button, menu-button-primary">

                <graphic>
                    <ImageView fx:id="continueIcon"
                               fitWidth="22.0"
                               fitHeight="22.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnNewGame"
                    text="NEW EXPEDITION"
                    onAction="#onNewGameClicked"
                    focusTraversable="false"
                    contentDisplay="LEFT"
                    graphicTextGap="14.0"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="newGameIcon"
                               fitWidth="22.0"
                               fitHeight="22.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnShop"
                    text="ARMORY"
                    onAction="#onShopClicked"
                    focusTraversable="false"
                    contentDisplay="LEFT"
                    graphicTextGap="14.0"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="shopIcon"
                               fitWidth="22.0"
                               fitHeight="22.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnLeaderboard"
                    text="HALL OF HEROES"
                    onAction="#onLeaderboardClicked"
                    focusTraversable="false"
                    contentDisplay="LEFT"
                    graphicTextGap="14.0"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="leaderboardIcon"
                               fitWidth="22.0"
                               fitHeight="22.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="accountButton"
                    text="PLAYER ACCOUNT"
                    onAction="#openAccount"
                    focusTraversable="false"
                    contentDisplay="LEFT"
                    graphicTextGap="14.0"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="accountIcon"
                               fitWidth="22.0"
                               fitHeight="22.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Button fx:id="btnSettings"
                    text="SETTINGS"
                    onAction="#onSettingsClicked"
                    focusTraversable="false"
                    contentDisplay="LEFT"
                    graphicTextGap="14.0"
                    styleClass="menu-button">

                <graphic>
                    <ImageView fx:id="settingsIcon"
                               fitWidth="22.0"
                               fitHeight="22.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnExit"
                    text="LEAVE THE NEXUS"
                    onAction="#onExitClicked"
                    focusTraversable="false"
                    contentDisplay="LEFT"
                    graphicTextGap="14.0"
                    styleClass="menu-button, menu-button-exit">

                <graphic>
                    <ImageView fx:id="exitIcon"
                               fitWidth="22.0"
                               fitHeight="22.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>
                </graphic>
            </Button>
        </VBox>

        <!-- Ten khu vuc -->
        <VBox alignment="BOTTOM_RIGHT"
              spacing="5.0"
              mouseTransparent="true"
              AnchorPane.rightAnchor="42.0"
              AnchorPane.bottomAnchor="28.0">

            <Label text="SOUL NEXUS"
                   styleClass="location-name"/>

            <Label text="A PLACE BETWEEN WORLDS"
                   styleClass="location-caption"/>
        </VBox>
    </AnchorPane>
</StackPane>