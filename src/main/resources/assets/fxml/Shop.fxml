<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.soulknight.ui.ShopController"
           stylesheets="@../CSS/Shop.css"
           styleClass="shop-overlay">

    <VBox prefWidth="1000.0"
          prefHeight="600.0"
          maxWidth="1000.0"
          maxHeight="600.0"
          spacing="16.0"
          styleClass="shop-window">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT"
              spacing="16.0"
              styleClass="shop-header">

            <VBox alignment="CENTER_LEFT"
                  spacing="5.0">

                <Label text="ARMORY"
                       styleClass="shop-title"/>

                <HBox alignment="CENTER_LEFT"
                      spacing="10.0">

                    <Region prefWidth="38.0"
                            prefHeight="2.0"
                            styleClass="shop-title-line"/>

                    <Label text="SOUL NEXUS SUPPLY ARCHIVE"
                           styleClass="shop-subtitle"/>
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="10.0">

                <HBox alignment="CENTER"
                      spacing="9.0"
                      styleClass="coin-badge">

                    <ImageView fx:id="coinIcon"
                               fitWidth="24.0"
                               fitHeight="24.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>

                    <Label fx:id="coinLabel"
                           text="0"
                           styleClass="coin-text"/>
                </HBox>

                <HBox alignment="CENTER"
                      spacing="9.0"
                      styleClass="gem-badge">

                    <ImageView fx:id="gemIcon"
                               fitWidth="24.0"
                               fitHeight="24.0"
                               preserveRatio="true"
                               smooth="false"
                               mouseTransparent="true"/>

                    <Label fx:id="gemLabel"
                           text="0"
                           styleClass="gem-text"/>
                </HBox>
            </HBox>

            <Button fx:id="closeButton"
                    text="X"
                    mnemonicParsing="false"
                    focusTraversable="false"
                    styleClass="pixel-btn-close"/>
        </HBox>

        <!-- Main content -->
        <HBox spacing="18.0"
              styleClass="shop-body"
              VBox.vgrow="ALWAYS">

            <!-- Sidebar -->
            <VBox prefWidth="205.0"
                  minWidth="205.0"
                  maxWidth="205.0"
                  spacing="10.0"
                  styleClass="shop-sidebar">

                <Label text="CATALOG"
                       styleClass="sidebar-title"/>

                <Region prefHeight="1.0"
                        maxWidth="175.0"
                        styleClass="sidebar-divider"/>

                <Button fx:id="tabPet"
                        text="PET COMPANIONS"
                        mnemonicParsing="false"
                        focusTraversable="false"
                        maxWidth="Infinity"
                        styleClass="tab-button, tab-active"/>

                <Button fx:id="tabWeapon"
                        text="WEAPONS"
                        mnemonicParsing="false"
                        focusTraversable="false"
                        maxWidth="Infinity"
                        styleClass="tab-button"/>

                <Button fx:id="tabHero"
                        text="CHARACTERS"
                        mnemonicParsing="false"
                        focusTraversable="false"
                        maxWidth="Infinity"
                        styleClass="tab-button"/>

                <Button fx:id="tabUpgrade"
                        text="BUFFS"
                        mnemonicParsing="false"
                        focusTraversable="false"
                        maxWidth="Infinity"
                        styleClass="tab-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="5.0"
                      styleClass="sidebar-note">

                    <Label text="SOUL NEXUS"
                           styleClass="sidebar-location"/>

                    <Label text="SELECT AN ITEM TO INSPECT"
                           wrapText="true"
                           styleClass="sidebar-caption"/>
                </VBox>
            </VBox>

            <!-- Item area -->
            <VBox spacing="12.0"
                  styleClass="shop-content"
                  HBox.hgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT"
                      styleClass="content-heading">

                    <VBox spacing="4.0">
                        <Label text="AVAILABLE EQUIPMENT"
                               styleClass="content-title"/>

                        <Label text="PURCHASE, EQUIP OR INSPECT ITEMS"
                               styleClass="content-caption"/>
                    </VBox>
                </HBox>

                <ScrollPane fitToWidth="true"
                            fitToHeight="false"
                            pannable="true"
                            hbarPolicy="NEVER"
                            styleClass="pixel-scroll"
                            VBox.vgrow="ALWAYS">

                    <content>
                        <FlowPane fx:id="itemGrid"
                                  hgap="14.0"
                                  vgap="14.0"
                                  prefWrapLength="700.0"
                                  styleClass="item-grid"/>
                    </content>
                </ScrollPane>

                <!-- Selected item preview -->
                <HBox alignment="CENTER_LEFT"
                      spacing="16.0"
                      styleClass="item-preview-bar">

                    <VBox spacing="6.0"
                          HBox.hgrow="ALWAYS">

                        <Label fx:id="selectedItemName"
                               text="SELECT AN ITEM"
                               styleClass="preview-title"/>

                        <Label fx:id="selectedItemDesc"
                               text="Item details will appear here."
                               wrapText="true"
                               maxWidth="560.0"
                               styleClass="preview-desc"/>
                    </VBox>

                    <Button fx:id="actionButton"
                            text="SELECT"
                            mnemonicParsing="false"
                            focusTraversable="false"
                            visible="false"
                            styleClass="pixel-btn-action"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>