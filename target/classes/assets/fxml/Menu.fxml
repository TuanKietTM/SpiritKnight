<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.soulknight.ui.Menu"
      stylesheets="@../CSS/Menu.css"
      styleClass="menu-container"
      alignment="CENTER"
      spacing="30"> <ImageView fx:id="imgCharacter" styleClass="menu-sprite"/>

    <Label text="SOUL KNIGHT" styleClass="menu-title"/>

    <VBox alignment="CENTER" spacing="15" styleClass="button-container">
        <Button fx:id="btnPlay" text="START GAME" onAction="#onPlayClicked" styleClass="menu-button" focusTraversable="false"/>
        <Button fx:id="btnSettings" text="SETTINGS" onAction="#onSettingsClicked" styleClass="menu-button" focusTraversable="false"/>
        <Button fx:id="btnExit" text="EXIT GAME" onAction="#onExitClicked" styleClass="menu-button" focusTraversable="false"/>
    </VBox>

</VBox>