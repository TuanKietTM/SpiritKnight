<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.soulknight.ui.LevelClearScreen"
      stylesheets="@../CSS/LevelClearScreen.css"
      styleClass="clear-container"
      alignment="CENTER"
      spacing="15">

    <Label text="Portal Unlocked" styleClass="clear-title"/>
    <Label fx:id="lblLevelBanner" text="Level: X-X" styleClass="clear-info"/>
    <Label fx:id="lblMissionTitle" text="Mission Title" styleClass="clear-info"/>
    <Label fx:id="lblProgress" text="Progress: 100%" styleClass="clear-info"/>
    <Label text="Walk into the portal to continue" styleClass="clear-prompt"/>

</VBox>